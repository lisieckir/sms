<div class="space-y-3 min-h-[200px]"
     id="stage-{{ stage.id }}"
     data-stage-id="{{ stage.id }}"
     x-init="Sortable.create($el, {
         group: 'kanban',
         animation: 150,
         ghostClass: 'opacity-50',
         onEnd: function(evt) {
             const taskId = evt.item.dataset.taskId;
             const stageId = evt.to.dataset.stageId;
             const position = evt.newIndex;
             if (taskId && stageId) {
                 htmx.ajax('PATCH', '/board/task/' + taskId + '/move', {
                     values: { stageId: stageId, position: position },
                     target: '#stage-' + stageId,
                     swap: 'outerHTML'
                 });
             }
         }
     })">
    {% for task in stage.tasks %}
    <a href="{{ path('app_task_show', {id: task.id}) }}"
        class="task-card"
       data-task-id="{{ task.id }}">
         <div class="task-card-top"><span class="task-id">#{{ task.id|slice(0, 6) }}</span><span class="task-arrow">↗</span></div>
         <h4 class="font-medium text-gray-800 text-sm">{{ task.title }}</h4>
        <div class="flex items-center justify-between mt-2">
            {% if task.assigneeName is defined and task.assigneeName %}
            <span class="text-xs text-gray-500">{{ task.assigneeName }}</span>
            {% endif %}
             <span class="priority-badge {{ task.priority == 'critical' ? 'priority-critical' : task.priority == 'high' ? 'priority-high' : '' }}">
                {{ task.priority }}
            </span>
        </div>
    </a>
    {% else %}
    <p class="text-gray-400 text-sm text-center py-8">No tasks</p>
    {% endfor %}
</div>
<style>
    .task-card{display:block;background:#fff;border:1px solid #e1e6e2;border-radius:13px;padding:14px;cursor:grab;text-decoration:none;transition:transform .2s,box-shadow .2s,border-color .2s}.task-card:hover{transform:translateY(-2px);border-color:#c4d4cb;box-shadow:0 10px 20px rgba(24,35,43,.08)}.task-card-top{display:flex;justify-content:space-between;margin-bottom:10px}.task-id{color:#9aa6a2;font:500 10px 'DM Mono',monospace}.task-arrow{color:#a9b4af}.task-card h4{line-height:1.45}.priority-badge{color:#68766f;background:#eef1ef;border-radius:99px;padding:4px 8px;font:500 10px 'DM Mono',monospace;text-transform:uppercase}.priority-high{color:#b36b28;background:#fff0dc}.priority-critical{color:#c84c42;background:#ffe4e1}
</style>
