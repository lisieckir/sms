{% extends 'base.html.twig' %}

{% block title %}Initialize Workflow{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-4 py-16">
    <div class="bg-white rounded-lg shadow p-8 text-center">
        <h1 class="text-2xl font-bold text-gray-800 mb-4">No Workflow Configured</h1>
        <p class="text-gray-600 mb-8">You need to create a workflow with stages before using the Kanban board.</p>
        <a href="{{ path('app_workflow_create_default') }}"
           class="inline-block bg-indigo-600 text-white px-6 py-3 rounded-lg hover:bg-indigo-700 font-medium">
            Create Default Workflow
        </a>
        <p class="mt-4 text-sm text-gray-500">
            This will create a standard workflow with: To Do → In Progress → Review → Done
        </p>
    </div>
</div>
{% endblock %}
