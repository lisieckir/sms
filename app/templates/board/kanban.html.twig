{% extends 'base.html.twig' %}

{% block title %}Board · Sidegigs{% endblock %}

{% block body %}
<div class="page-frame">
    <div class="flex justify-between items-center mb-6">
        <div><div class="eyebrow">Workspace / 01</div><h1 class="display-title">Dzień dobry, {{ app.user.userIdentifier }}.</h1><p class="mt-3 text-sm text-gray-500">Zobacz, co dzieje się ze zleceniami.</p></div>
        <form id="board-filters" class="flex items-center space-x-4">
            <label class="flex items-center space-x-2 text-sm text-gray-600 cursor-pointer">
                <input type="checkbox"
                       hx-get="{{ path('app_board') }}"
                       hx-target="body"
                       hx-trigger="change"
                       hx-include="closest form"
                       name="assigneeId"
                       value="{{ app.user.userId }}"
                       {{ selectedAssigneeId == app.user.userId ? 'checked' : '' }}>
                <span class="text-xs font-bold text-gray-600">My tasks</span>
            </label>
            <select name="clientId"
                    class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                    hx-get="{{ path('app_board') }}"
                    hx-target="body"
                    hx-trigger="change"
                    hx-include="closest form">
                <option value="">All Clients</option>
                {% for client in clients %}
                <option value="{{ client.id.value }}" {{ selectedClientId == client.id.value ? 'selected' : '' }}>
                    {{ client.name }}
                </option>
                {% endfor %}
            </select>
            {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_workflow_edit') }}"
               class="text-xs font-bold text-gray-500 hover:text-gray-800">Configure workflow ↗</a>
            {% endif %}
            <button class="btn-primary"
                    hx-get="{{ path('app_task_create_modal') }}"
                    hx-target="#modal"
                    hx-trigger="click">
                Create Task
            </button>
        </form>
    </div>

    <div id="modal"></div>

    {% if stages|length > 0 %}
    <div class="board-scroll" x-data="{}">
        {% for stage in stages %}
        <div class="board-column">
            <div class="board-column-inner">
                <h3 class="font-semibold text-gray-700 mb-3 flex items-center justify-between">
                    <span>{{ stage.name }}</span>
                    <span class="flex items-center gap-2">
                        {% if workflow and stage.id %}
                        <span class="relative group" x-data="{ open: false }"
                              @mouseenter="open = true" @mouseleave="open = false">
                            <span class="count-pill">{{ stage.tasks|length }}</span>
                            <div x-show="open" class="absolute bottom-full mb-2 left-1/2 -translate-x-1/2 bg-gray-800 text-white text-xs rounded-lg px-3 py-2 whitespace-nowrap z-10"
                                 x-cloak>
                                {% set allowed = workflow.transitions|filter(t => t.fromStageId == stage.id) %}
                                {% if allowed|length > 0 %}
                                <p class="font-medium mb-1">Allowed moves:</p>
                                {% for t in allowed %}
                                {% set targetStage = workflow.sortedStages|filter(s => s.id == t.toStageId)|first %}
                                <span class="text-green-300 block">→ {{ targetStage ? targetStage.name : t.toStageId }}</span>
                                {% endfor %}
                                {% else %}
                                <span class="text-gray-400">No outgoing moves</span>
                                {% endif %}
                                <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-gray-800"></div>
                            </div>
                        </span>
                        {% else %}
                        <span class="count-pill">{{ stage.tasks|length }}</span>
                        {% endif %}
                    </span>
                </h3>
                {% include 'board/_column.html.twig' with {stage: stage} only %}
            </div>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="flex-1 text-center py-16">
        <p class="text-gray-500 text-lg">No workflow configured yet.</p>
        {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_workflow_init') }}"
           class="btn-primary mt-4 inline-block">
            Configure Workflow
        </a>
        {% endif %}
    </div>
    {% endif %}
</div>
<style>
    .board-scroll{display:flex;gap:16px;overflow-x:auto;padding:4px 2px 20px;align-items:flex-start}.board-column{flex:0 0 286px}.board-column-inner{background:#edf0ed;border:1px solid #e1e6e2;border-radius:18px;padding:14px}.board-column h3{font-size:12px;letter-spacing:.01em}.count-pill{background:#fff;color:#82908a;font:500 11px 'DM Mono',monospace;border-radius:99px;padding:4px 8px}
    @media(max-width:700px){.board-scroll{margin:0 -16px;padding-left:16px;padding-right:16px;scroll-snap-type:x mandatory}.board-column{scroll-snap-align:start;flex-basis:calc(100vw - 48px)}}
</style>
{% endblock %}
