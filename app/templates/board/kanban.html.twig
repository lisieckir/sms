{% extends 'base.html.twig' %}

{% block title %}Kanban Board{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Kanban Board</h1>
        <form id="board-filters" class="flex items-center space-x-4">
            <label class="flex items-center space-x-2 text-sm text-gray-600 cursor-pointer">
                <input type="checkbox"
                       hx-get="{{ path('app_board') }}"
                       hx-target="body"
                       hx-trigger="change"
                       hx-include="closest form"
                       name="assigneeId"
                       value="{{ app.user.userId }}"
                       {{ selectedAssigneeId == app.user.userId ? 'checked' : '' }}>
                <span>My Tasks</span>
            </label>
            <select name="clientId"
                    class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                    hx-get="{{ path('app_board') }}"
                    hx-target="body"
                    hx-trigger="change"
                    hx-include="closest form">
                <option value="">All Clients</option>
                {% for client in clients %}
                <option value="{{ client.id.value }}" {{ selectedClientId == client.id.value ? 'selected' : '' }}>
                    {{ client.name }}
                </option>
                {% endfor %}
            </select>
            {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_workflow_edit') }}"
               class="text-sm text-indigo-600 hover:text-indigo-800">Configure Workflow</a>
            {% endif %}
            <button class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700"
                    hx-get="{{ path('app_task_create_modal') }}"
                    hx-target="#modal"
                    hx-trigger="click">
                Create Task
            </button>
        </form>
    </div>

    <div id="modal"></div>

    {% if stages|length > 0 %}
    <div class="flex space-x-4 overflow-x-auto pb-4" x-data="{}">
        {% for stage in stages %}
        <div class="flex-shrink-0 w-72">
            <div class="bg-gray-100 rounded-lg p-4">
                <h3 class="font-semibold text-gray-700 mb-3 flex items-center justify-between">
                    <span>{{ stage.name }}</span>
                    <span class="flex items-center gap-2">
                        {% if workflow and stage.id %}
                        <span class="relative group" x-data="{ open: false }"
                              @mouseenter="open = true" @mouseleave="open = false">
                            <span class="text-xs text-gray-400 bg-gray-200 rounded-full px-2 py-0.5 cursor-help">{{ stage.tasks|length }}</span>
                            <div x-show="open" class="absolute bottom-full mb-2 left-1/2 -translate-x-1/2 bg-gray-800 text-white text-xs rounded-lg px-3 py-2 whitespace-nowrap z-10"
                                 x-cloak>
                                {% set allowed = workflow.transitions|filter(t => t.fromStageId == stage.id) %}
                                {% if allowed|length > 0 %}
                                <p class="font-medium mb-1">Allowed moves:</p>
                                {% for t in allowed %}
                                {% set targetStage = workflow.sortedStages|filter(s => s.id == t.toStageId)|first %}
                                <span class="text-green-300 block">→ {{ targetStage ? targetStage.name : t.toStageId }}</span>
                                {% endfor %}
                                {% else %}
                                <span class="text-gray-400">No outgoing moves</span>
                                {% endif %}
                                <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-gray-800"></div>
                            </div>
                        </span>
                        {% else %}
                        <span class="text-xs text-gray-400 bg-gray-200 rounded-full px-2 py-0.5">{{ stage.tasks|length }}</span>
                        {% endif %}
                    </span>
                </h3>
                {% include 'board/_column.html.twig' with {stage: stage} only %}
            </div>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="flex-1 text-center py-16">
        <p class="text-gray-500 text-lg">No workflow configured yet.</p>
        {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_workflow_init') }}"
           class="mt-4 inline-block bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700">
            Configure Workflow
        </a>
        {% endif %}
    </div>
    {% endif %}
</div>
{% endblock %}
