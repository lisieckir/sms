{% extends 'base.html.twig' %}

{% block title %}{{ task.title }}{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-800">{{ task.title }}</h1>
        <a href="{{ path('app_board') }}" class="text-indigo-600 hover:text-indigo-800">Back to Board</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="md:col-span-2 space-y-6">
            {% if task.subtasks|length > 0 %}
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">Subtickets</h2>
                <div class="space-y-2">
                    {% for sub in task.subtasks %}
                    <div class="flex items-center justify-between bg-gray-50 rounded-lg px-4 py-2">
                        <a href="{{ path('app_task_show', {id: sub.id}) }}"
                           class="text-indigo-600 hover:text-indigo-800 text-sm font-medium">
                            {{ sub.title }}
                        </a>
                        <span class="text-sm text-gray-500">{{ sub.totalTimeSpent }}m</span>
                    </div>
                    {% endfor %}
                    <div class="text-right text-sm font-semibold text-gray-700 pt-2 border-t">
                        Total from subtickets: {{ task.totalTimeSpent }}m ({{ (task.totalTimeSpent / 60)|round(1) }}h)
                    </div>
                </div>
            </div>
            {% endif %}

            <div class="bg-white rounded-lg shadow p-6" x-data="{
                editing: false,
                text: '{{ (task.description ?: '')|e('js') }}',
                save() {
                    fetch('{{ path('app_task_edit_description', {id: task.id}) }}', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                        body: 'description=' + encodeURIComponent(this.text)
                    }).then(() => { this.editing = false; location.reload(); });
                }
            }">
                <div class="flex items-center justify-between mb-2">
                    <h2 class="text-lg font-semibold text-gray-800">Description</h2>
                    <button @click="editing = !editing; if(editing) $nextTick(() => $refs.textarea.focus())"
                            class="text-sm text-indigo-600 hover:text-indigo-800"
                            x-text="editing ? 'Cancel' : 'Edit'"></button>
                </div>
                <template x-if="!editing">
                    <p class="text-gray-600" x-text="text || 'No description'"></p>
                </template>
                <template x-if="editing">
                    <div>
                        <textarea x-model="text" x-ref="textarea" rows="4"
                                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"></textarea>
                        <div class="mt-2 flex justify-end gap-2">
                            <button @click="editing = false"
                                    class="px-3 py-1 border border-gray-300 rounded text-sm text-gray-700 hover:bg-gray-50">Cancel</button>
                            <button @click="save()"
                                    class="px-3 py-1 bg-indigo-600 text-white rounded text-sm hover:bg-indigo-700">Save</button>
                        </div>
                    </div>
                </template>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-lg font-semibold text-gray-800">Comments</h2>
                </div>

                <form method="post" action="{{ path('app_task_comment', {id: task.id}) }}" class="mb-4">
                    <textarea name="content" rows="2" placeholder="Add a comment..." required
                              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"></textarea>
                    <button type="submit" class="mt-2 bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 text-sm">Add Comment</button>
                </form>

                {% if task.comments|length > 0 %}
                <div class="space-y-3">
                    {% for comment in task.comments %}
                    <div class="bg-gray-50 rounded-lg p-3">
                        <p class="text-gray-700 text-sm">{{ comment.content }}</p>
                        <p class="text-xs text-gray-500 mt-1">
                            <span class="font-medium text-indigo-600">@{{ comment.userName ?? comment.userId }}</span>
                            &middot; {{ comment.createdAt|date('Y-m-d H:i') }}
                        </p>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <p class="text-gray-500 text-sm">No comments yet.</p>
                {% endif %}
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-lg font-semibold text-gray-800">Worklogs</h2>
                </div>

                <form method="post" action="{{ path('app_task_worklog', {id: task.id}) }}" class="mb-4 flex gap-2">
                    <input type="number" name="minutes" placeholder="Minutes" required min="1"
                           class="w-24 px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    <input type="text" name="description" placeholder="What did you do?" required
                           class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    <button type="submit" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 text-sm">Log</button>
                </form>

                {% if task.worklogs|length > 0 %}
                <div class="space-y-2">
                    {% for worklog in task.worklogs %}
                    <div class="flex justify-between items-center bg-gray-50 rounded-lg p-3">
                        <div>
                            <p class="text-gray-700 text-sm">{{ worklog.description }}</p>
                            <p class="text-xs text-gray-500">
                                <span class="font-medium text-indigo-600">@{{ worklog.userName ?? worklog.userId }}</span>
                                &middot; {{ worklog.date }}
                            </p>
                        </div>
                        <span class="text-sm font-medium text-gray-700">{{ worklog.minutes }}m</span>
                    </div>
                    {% endfor %}
                    <div class="text-right text-sm font-semibold text-gray-700 pt-2 border-t">
                        Total: {{ task.totalTimeSpent }}m ({{ (task.totalTimeSpent / 60)|round(1) }}h)
                    </div>
                </div>
                {% else %}
                <p class="text-gray-500 text-sm">No work logged yet.</p>
                {% endif %}
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">Add Subticket</h2>
                <form method="post" action="{{ path('app_task_create_subtask', {id: task.id}) }}" class="flex gap-2">
                    <input type="text" name="title" placeholder="Subticket title" required
                           class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    <button type="submit" class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 text-sm">Create</button>
                </form>
            </div>
        </div>

        <div class="space-y-6">
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">Details</h2>
                <dl class="space-y-3">
                    <div>
                        <dt class="text-xs text-gray-500 uppercase">Status</dt>
                        <dd class="text-sm font-medium text-gray-700">{{ task.status }}</dd>
                    </div>
                    <div>
                        <dt class="text-xs text-gray-500 uppercase">Stage</dt>
                        <dd class="text-sm font-medium text-gray-700">{{ task.stageName }}</dd>
                    </div>
                    <div>
                        <dt class="text-xs text-gray-500 uppercase">Position</dt>
                        <dd class="text-sm font-medium text-gray-700">{{ task.position }}</dd>
                    </div>
                    <div x-data="{
                         editing: false,
                         search: '',
                         results: [],
                         selectedName: '{{ (task.assigneeName ?? 'Unassigned')|e('js') }}',
                         selectedId: '{{ (task.assigneeId ?? '')|e('js') }}',
                         async searchUsers() {
                             if (this.search.length < 1) { this.results = []; return; }
                             let r = await fetch('{{ path('app_user_search') }}?q=' + encodeURIComponent(this.search));
                             this.results = await r.json();
                         },
                         selectUser(id, name) {
                             this.selectedId = id;
                             this.selectedName = name;
                             this.editing = false;
                             fetch('{{ path('app_task_assign', {id: task.id}) }}', {
                                 method: 'POST',
                                 headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                                 body: 'assigneeId=' + encodeURIComponent(id || '')
                             });
                         }
                     }">
                         <dt class="text-xs text-gray-500 uppercase">Assignee</dt>
                         <template x-if="!editing">
                             <dd class="text-sm font-medium text-gray-700 cursor-pointer hover:text-indigo-600"
                                 @click="editing = true; search = ''; results = []">
                                 <span x-text="selectedName || 'Unassigned'"></span>
                             </dd>
                         </template>
                         <template x-if="editing">
                             <dd class="relative">
                                 <input type="text" x-model="search" @input.debounce.300ms="searchUsers()" @click.outside="editing = false"
                                        placeholder="Search users..."
                                        class="w-full px-2 py-1 border border-gray-300 rounded text-sm"
                                        x-ref="searchInput" x-init="$nextTick(() => $refs.searchInput.focus())">
                                 <div class="absolute z-10 w-full mt-1 bg-white border rounded shadow-lg max-h-40 overflow-y-auto"
                                      x-show="results.length > 0">
                                     <template x-for="user in results" :key="user.id">
                                         <div class="px-3 py-2 hover:bg-indigo-50 cursor-pointer text-sm"
                                              @click="selectUser(user.id, user.name)">
                                             <span x-text="user.name"></span>
                                             <span class="text-gray-400" x-text="'(@' + user.username + ')'"></span>
                                         </div>
                                     </template>
                                 </div>
                                 <div class="mt-1">
                                     <button @click="selectUser('', null)" class="text-xs text-gray-500 hover:text-red-600">Unassign</button>
                                 </div>
                             </dd>
                         </template>
                     </div>
                      <div x-data="{
                          editing: false,
                          search: '',
                          results: [],
                          selectedName: '{{ (task.clientName ?? 'None')|e('js') }}',
                          selectedId: '{{ (task.clientId ?? '')|e('js') }}',
                          async searchClients() {
                              let r = await fetch('{{ path('app_client_search') }}?q=' + encodeURIComponent(this.search));
                              this.results = await r.json();
                          },
                          selectClient(id, name) {
                              this.selectedId = id;
                              this.selectedName = name;
                              this.editing = false;
                              fetch('{{ path('app_task_assign_client', {id: task.id}) }}', {
                                  method: 'POST',
                                  headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                                  body: 'clientId=' + encodeURIComponent(id || '')
                              });
                          }
                      }">
                          <dt class="text-xs text-gray-500 uppercase">Client</dt>
                          <template x-if="!editing">
                              <dd class="text-sm font-medium text-gray-700 cursor-pointer hover:text-indigo-600"
                                  @click="editing = true; search = ''; results = []; $nextTick(() => searchClients())">
                                  <span x-text="selectedName || 'None'"></span>
                              </dd>
                          </template>
                          <template x-if="editing">
                              <dd class="relative" @click.outside="editing = false">
                                  <input type="text" x-model="search" @input.debounce.300ms="searchClients()"
                                         placeholder="Search clients..."
                                         class="w-full px-2 py-1 border border-gray-300 rounded text-sm"
                                         x-ref="searchInput" x-init="$nextTick(() => { $refs.searchInput.focus(); searchClients(); })">
                                  <div class="absolute z-10 w-full mt-1 bg-white border rounded shadow-lg max-h-40 overflow-y-auto"
                                       x-show="results.length > 0 || search.length === 0">
                                      <template x-for="client in results" :key="client.id">
                                          <div class="px-3 py-2 hover:bg-indigo-50 cursor-pointer text-sm"
                                               @click="selectClient(client.id, client.name)">
                                              <span x-text="client.name"></span>
                                          </div>
                                      </template>
                                      <template x-if="results.length === 0 && search.length > 0">
                                          <div class="px-3 py-2 text-gray-400 text-sm">No clients found</div>
                                      </template>
                                  </div>
                                  <div class="mt-1">
                                      <button @click="selectClient('', null)" class="text-xs text-gray-500 hover:text-red-600">Unset client</button>
                                  </div>
                              </dd>
                          </template>
                      </div>
                    {% if task.parentTaskId %}
                    <div>
                        <dt class="text-xs text-gray-500 uppercase">Parent Task</dt>
                        <dd class="text-sm font-medium text-gray-700">
                            <a href="{{ path('app_task_show', {id: task.parentTaskId}) }}" class="text-indigo-600 hover:text-indigo-800">
                                {{ task.parentTaskName ?? task.parentTaskId }}
                            </a>
                        </dd>
                    </div>
                    {% endif %}
                    <div>
                        <dt class="text-xs text-gray-500 uppercase">Created</dt>
                        <dd class="text-sm font-medium text-gray-700">{{ task.createdAt|date('Y-m-d H:i') }}</dd>
                    </div>
                    <div>
                        <dt class="text-xs text-gray-500 uppercase">Updated</dt>
                        <dd class="text-sm font-medium text-gray-700">{{ task.updatedAt|date('Y-m-d H:i') }}</dd>
                    </div>
                    <div>
                        <dt class="text-xs text-gray-500 uppercase">Total Time</dt>
                        <dd class="text-sm font-medium text-gray-700">{{ task.totalTimeSpent }}m</dd>
                    </div>
                </dl>
                <div class="mt-4 pt-4 border-t space-y-2">
                    <a href="{{ path('app_task_history', {id: task.id}) }}" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium block">View History &rarr;</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
