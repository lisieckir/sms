{% extends 'base.html.twig' %}

{% block title %}Task History{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto px-4 py-8">
    <div class="mb-6">
        <a href="{{ path('app_task_show', { id: taskId }) }}" class="text-blue-600 hover:text-blue-800">&larr; Back to task</a>
    </div>

    <h1 class="text-2xl font-bold mb-6">Task History</h1>

    <div class="space-y-4">
        {% for event in events %}
            <div class="bg-white rounded-lg shadow p-4 border-l-4
                {% if event.type == 'TaskCreated' %}border-green-500
                {% elseif event.type == 'TaskMoved' %}border-blue-500
                {% elseif event.type == 'TaskAssigned' %}border-purple-500
                {% elseif event.type == 'TaskDescriptionChanged' %}border-yellow-500
                {% elseif event.type == 'CommentAdded' %}border-yellow-500
                {% elseif event.type == 'WorklogAdded' %}border-orange-500
                {% else %}border-gray-300{% endif %}">
                <div class="flex items-center justify-between">
                    <span class="font-semibold text-gray-800">{{ event.type }}</span>
                    <span class="text-sm text-gray-500">{{ event.occurredAt|date('Y-m-d H:i:s') }}</span>
                </div>
                <div class="mt-2 text-sm text-gray-600">
                    {% if event.type == 'TaskCreated' %}
                        Created task "{{ event.data.title|default('') }}"
                    {% elseif event.type == 'TaskMoved' %}
                        Moved from <strong>{{ event.data.fromStageName|default(event.data.fromStageId|default('?')) }}</strong> to <strong>{{ event.data.toStageName|default(event.data.toStageId|default('?')) }}</strong>
                    {% elseif event.type == 'TaskDescriptionChanged' %}
                        Description updated
                    {% elseif event.type == 'TaskAssigned' %}
                        Assigned to <strong>{{ event.data.newAssigneeName|default(event.data.newAssigneeId|default('?')) }}</strong>
                    {% elseif event.type == 'CommentAdded' %}
                        Comment added
                    {% elseif event.type == 'WorklogAdded' %}
                        Logged {{ event.data.minutes|default(0) }} minutes
                    {% else %}
                        {{ event.data|json_encode }}
                    {% endif %}
                </div>
            </div>
        {% else %}
            <p class="text-gray-500">No events recorded for this task.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}
