{% extends 'base.html.twig' %}

{% block title %}Assign User{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-4 py-8">
    <div class="mb-6">
        <a href="{{ path('app_task_show', { id: taskId }) }}" class="text-indigo-600 hover:text-indigo-800">&larr; Back to task</a>
    </div>

    <h1 class="text-2xl font-bold text-gray-800 mb-6">Assign User to Task</h1>

    <div class="bg-white rounded-lg shadow">
        <form method="post" action="{{ path('app_task_assign', { id: taskId }) }}" class="p-6">
            <div class="mb-4">
                <label for="assigneeId" class="block text-sm font-medium text-gray-700 mb-1">Select User</label>
                <select name="assigneeId" id="assigneeId"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    <option value="">Unassigned</option>
                    {% for user in users %}
                    <option value="{{ user.id().value() }}" {{ user.id().value() == currentAssigneeId ? 'selected' : '' }}>
                        {{ user.name().fullName() }} (@{{ user.username() }})
                    </option>
                    {% endfor %}
                </select>
            </div>
            <div class="flex justify-end space-x-3">
                <a href="{{ path('app_task_show', { id: taskId }) }}"
                   class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">Cancel</a>
                <button type="submit"
                        class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700">Assign</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
