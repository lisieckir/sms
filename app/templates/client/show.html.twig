{% extends 'base.html.twig' %}

{% block title %}{{ client.name }}{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-800">{{ client.name }}</h1>
        <div class="flex items-center space-x-3">
            <a href="{{ path('app_client_list') }}" class="text-indigo-600 hover:text-indigo-800">Back to Clients</a>
            <a href="{{ path('app_client_edit', {id: client.id.value}) }}"
               class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 text-sm">Edit</a>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="md:col-span-2 space-y-6">
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">Details</h2>
                <dl class="grid grid-cols-2 gap-4">
                    <div>
                        <dt class="text-xs text-gray-500 uppercase">NIP</dt>
                        <dd class="text-sm font-medium text-gray-700">{{ client.nip.value }}</dd>
                    </div>
                    <div>
                        <dt class="text-xs text-gray-500 uppercase">Status</dt>
                        <dd class="text-sm font-medium">
                            <span class="px-2 py-0.5 rounded-full text-xs {{ client.isActive ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' }}">
                                {{ client.status }}
                            </span>
                        </dd>
                    </div>
                    <div>
                        <dt class="text-xs text-gray-500 uppercase">Email</dt>
                        <dd class="text-sm font-medium text-gray-700">{{ client.email ?: '—' }}</dd>
                    </div>
                    <div>
                        <dt class="text-xs text-gray-500 uppercase">Sposób rozliczenia</dt>
                        <dd class="text-sm font-medium text-gray-700">
                            {% if client.settlementType.value == 'b2b' %}B2B
                            {% elseif client.settlementType.value == 'useme' %}Useme
                            {% elseif client.settlementType.value == 'umowa_zlecenie' %}Umowa zlecenie
                            {% else %}{{ client.settlementType.value }}{% endif %}
                        </dd>
                    </div>
                    <div>
                        <dt class="text-xs text-gray-500 uppercase">Country</dt>
                        <dd class="text-sm font-medium text-gray-700">{{ client.country }}</dd>
                    </div>
                    <div class="col-span-2">
                        <dt class="text-xs text-gray-500 uppercase">Address</dt>
                        <dd class="text-sm font-medium text-gray-700">{{ client.address }}</dd>
                    </div>
                    <div class="col-span-2">
                        <dt class="text-xs text-gray-500 uppercase">Description</dt>
                        <dd class="text-sm text-gray-600">{{ client.description ?: 'No description' }}</dd>
                    </div>
                </dl>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">Contacts</h2>

                <form method="post" action="{{ path('app_client_add_contact', {id: client.id.value}) }}" class="mb-4 grid grid-cols-2 gap-2">
                    <input type="text" name="firstName" placeholder="First name" required
                           class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    <input type="text" name="lastName" placeholder="Last name" required
                           class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    <input type="email" name="email" placeholder="Email" required
                           class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    <input type="text" name="phone" placeholder="Phone (optional)"
                           class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    <button type="submit" class="col-span-2 bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 text-sm">Add Contact</button>
                </form>

                {% if client.contacts|length > 0 %}
                <div class="space-y-2">
                    {% for contact in client.contacts %}
                    <div class="flex items-center justify-between bg-gray-50 rounded-lg p-3">
                        <div>
                            <p class="text-sm font-medium text-gray-700">{{ contact.firstName }} {{ contact.lastName }}</p>
                            <p class="text-xs text-gray-500">{{ contact.email }}{{ contact.phone ? ' | ' ~ contact.phone : '' }}</p>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <p class="text-gray-500 text-sm">No contacts.</p>
                {% endif %}
            </div>
        </div>

        <div class="space-y-6">
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">Actions</h2>
                <div class="space-y-3">
                    {% if client.isDeleted %}
                        <form method="post" action="{{ path('app_client_restore', {id: client.id.value}) }}">
                            <button type="submit" class="w-full px-4 py-2 rounded-lg text-white bg-green-600 hover:bg-green-700">Restore Client</button>
                        </form>
                    {% else %}
                        <form method="post" action="{{ path('app_client_toggle_block', {id: client.id.value}) }}">
                            <button type="submit" class="w-full px-4 py-2 rounded-lg text-white {{ client.isActive ? 'bg-red-600 hover:bg-red-700' : 'bg-green-600 hover:bg-green-700' }}">
                                {{ client.isActive ? 'Block Client' : 'Unblock Client' }}
                            </button>
                        </form>
                        <form method="post" action="{{ path('app_client_delete', {id: client.id.value}) }}" onsubmit="return confirm('Delete this client?')">
                            <button type="submit" class="w-full px-4 py-2 rounded-lg text-white bg-red-700 hover:bg-red-800">Delete Client</button>
                        </form>
                    {% endif %}
                </div>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-2">Created</h2>
                <p class="text-sm text-gray-600">{{ client.createdAt|date('Y-m-d H:i') }}</p>
                <h2 class="text-lg font-semibold text-gray-800 mb-2 mt-4">Updated</h2>
                <p class="text-sm text-gray-600">{{ client.updatedAt|date('Y-m-d H:i') }}</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
